{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/my-app/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lightbook-api.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://lightbook-api.onrender.com/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
