PORT=3002
DB_NAME=lightbooks_web2_dev
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/
# Optional: set this if Node's local DNS resolver cannot resolve MongoDB SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Chatbot Thủ thư Lightbook (POST /api/librarian): lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model chính; hết lượt miễn phí / quá tải thì tự chuyển sang gemini-flash-lite-latest, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash