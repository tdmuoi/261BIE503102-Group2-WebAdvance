PORT=3002
DB_NAME=lightbooks_web2_dev
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/
# Optional: set this if Node's local DNS resolver cannot resolve MongoDB SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Chatbot Thủ thư Lightbook (POST /api/librarian): lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model chính; hết lượt miễn phí / quá tải thì tự chuyển sang gemini-flash-lite-latest, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash
# Ảnh khách tải lên (avatar, ảnh sách thanh lý) lưu trên Cloudinary, MongoDB chỉ lưu link.
# Lấy ở https://console.cloudinary.com → Dashboard (API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gửi mã OTP qua email (xác minh email khi đăng ký, xác thực 2 lớp, quên mật khẩu).
# Dùng 1 Gmail của nhóm: bật Xác minh 2 bước → myaccount.google.com/apppasswords → tạo "Mật khẩu ứng dụng" 16 ký tự.
# Để trống = chế độ thử: không gửi email thật, mã OTP in ra terminal của server.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# MAIL_FROM="Lightbook <ten-nhom@gmail.com>"

# Thanh toán MoMo. Để trống = môi trường TEST của MoMo (tiền ảo, key test công khai của MoMo).
# Lên production: đổi MOMO_ENDPOINT=https://payment.momo.vn và điền key thật của shop.
# MOMO_ENDPOINT=https://test-payment.momo.vn
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# Địa chỉ web khách hàng (MoMo chuyển khách về {CLIENT_URL}/checkout sau khi thanh toán)
# CLIENT_URL=http://localhost:4200
# MoMo gọi về server báo kết quả — cần địa chỉ public (vd. ngrok). Không đặt thì server tự hỏi MoMo khi khách quay lại.
# MOMO_IPN_URL=https://xxxx.ngrok-free.app/api/payments/momo/ipn

# Đăng nhập bằng Google: https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3002/api/auth/oauth/google/callback (và {CLIENT_URL}/api/auth/oauth/google/callback khi deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Đăng nhập bằng Facebook: https://developers.facebook.com/apps → tạo app → Facebook Login
# Valid OAuth Redirect URI: {CLIENT_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Tuỳ chọn: gốc địa chỉ callback OAuth. Mặc định http://localhost:3002/api (máy mình) hoặc {CLIENT_URL}/api (production).
# OAUTH_REDIRECT_BASE=